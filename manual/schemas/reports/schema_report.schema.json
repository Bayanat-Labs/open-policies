{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayanatlabs.com/open/schemas/reports/schema_report.schema.json",
  "title": "Bayanat Labs gate report: job:validation/schema_report.json",
  "description": "Generated by scripts/gen_report_schemas.py from the checks in manual/stages.yaml and manual/dod.yaml that read this file; do not edit by hand. Declares the type of every field a check reads. Extra keys are allowed. A check is n/a only through a memo condition, never because the report says so. Apache-2.0.",
  "type": "object",
  "x-root": "job",
  "x-path": "validation/schema_report.json",
  "properties": {
    "records_valid": {
      "type": "number",
      "x-checks": [
        "S3.all_valid"
      ]
    },
    "normalisation_version": {
      "x-checks": [
        "S3.norm_version"
      ]
    },
    "records_missing_raw_field": {
      "type": "number",
      "x-checks": [
        "S3.raw_kept"
      ]
    },
    "audio": {
      "type": "object",
      "properties": {
        "max_release_sample_rate_hz": {
          "type": "number",
          "x-checks": [
            "S3.sample_rate"
          ]
        },
        "segments_from_auto_captions": {
          "type": "number",
          "x-checks": [
            "S3.no_auto_captions"
          ]
        },
        "max_cer_between_systems_kept": {
          "type": "number",
          "x-checks": [
            "S3.dual_asr"
          ]
        },
        "music_flagged_segments_in_release": {
          "type": "number",
          "x-checks": [
            "S3.music_excluded"
          ]
        }
      }
    }
  },
  "required": [
    "records_missing_raw_field",
    "records_valid"
  ]
}
