{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayanatlabs.com/open/schemas/reports/package.schema.json",
  "title": "Bayanat Labs gate report: job:qa/reports/package.json",
  "description": "Generated by scripts/gen_report_schemas.py from the checks in manual/stages.yaml and manual/dod.yaml that read this file; do not edit by hand. Declares the type of every field a check reads. Extra keys are allowed. A check is n/a only through a memo condition, never because the report says so. Apache-2.0.",
  "type": "object",
  "x-root": "job",
  "x-path": "qa/reports/package.json",
  "properties": {
    "viewer_renders": {
      "type": "boolean",
      "x-checks": [
        "S8.viewer"
      ]
    },
    "load_dataset_clean_env_ok": {
      "type": "boolean",
      "x-checks": [
        "S8.loader"
      ]
    },
    "card_lint_errors": {
      "type": "number",
      "x-checks": [
        "D05.lint",
        "S8.lint"
      ]
    },
    "croissant_valid": {
      "type": "boolean",
      "x-checks": [
        "D05.croissant",
        "S8.croissant"
      ]
    },
    "checksum_mismatches": {
      "type": "number",
      "x-checks": [
        "S8.checksums"
      ]
    },
    "card_manual_version": {
      "x-checks": [
        "S8.manual_version"
      ]
    },
    "synthetic_records_unlabelled": {
      "type": "number",
      "x-checks": [
        "S8.synthetic_labelled"
      ]
    },
    "example_reproduced_clean_env": {
      "type": "boolean",
      "x-checks": [
        "D05.example"
      ]
    }
  },
  "required": [
    "card_lint_errors",
    "checksum_mismatches",
    "croissant_valid",
    "load_dataset_clean_env_ok",
    "synthetic_records_unlabelled",
    "viewer_renders"
  ]
}
