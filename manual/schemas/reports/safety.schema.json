{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayanatlabs.com/open/schemas/reports/safety.schema.json",
  "title": "Bayanat Labs gate report: job:qa/reports/safety.json",
  "description": "Generated by scripts/gen_report_schemas.py from the checks in manual/stages.yaml and manual/dod.yaml that read this file; do not edit by hand. Declares the type of every field a check reads. Extra keys are allowed. A check is n/a only through a memo condition, never because the report says so. Apache-2.0.",
  "type": "object",
  "x-root": "job",
  "x-path": "qa/reports/safety.json",
  "properties": {
    "identifiable_minor_items_remaining": {
      "type": "number",
      "x-checks": [
        "S5.minors"
      ]
    },
    "flagged_items_without_human_decision": {
      "type": "number",
      "x-checks": [
        "S5.flags_reviewed"
      ]
    },
    "images": {
      "type": "object",
      "properties": {
        "unblurred_faces_or_plates": {
          "type": "number",
          "x-checks": [
            "S5.faces_plates"
          ]
        },
        "csam_hash_check_done": {
          "type": "boolean",
          "x-checks": [
            "S5.csam"
          ]
        },
        "exif_or_gps_remaining": {
          "type": "number",
          "x-checks": [
            "S5.exif"
          ]
        }
      }
    }
  },
  "required": [
    "flagged_items_without_human_decision",
    "identifiable_minor_items_remaining"
  ]
}
