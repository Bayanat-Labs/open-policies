{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayanatlabs.com/open/schemas/reports/discovery.schema.json",
  "title": "Bayanat Labs gate report: job:qa/reports/discovery.json",
  "description": "Generated by scripts/gen_report_schemas.py from the checks in manual/stages.yaml and manual/dod.yaml that read this file; do not edit by hand. Declares the type of every field a check reads. Extra keys are allowed. A check is n/a only through a memo condition, never because the report says so. Apache-2.0.",
  "type": "object",
  "x-root": "job",
  "x-path": "qa/reports/discovery.json",
  "properties": {
    "red_items_included": {
      "type": "number",
      "x-checks": [
        "S1.red_excluded"
      ]
    },
    "sources_without_tos_basis": {
      "type": "number",
      "x-checks": [
        "S1.tos_basis"
      ]
    },
    "sources_terms_not_reviewed": {
      "type": "number",
      "x-checks": [
        "S1.terms_read"
      ]
    },
    "items_missing_rights_signals": {
      "type": "number",
      "x-checks": [
        "S1.rights_signals"
      ]
    },
    "video_host": {
      "type": "object",
      "properties": {
        "trainability_stored_as_filter_column": {
          "type": "boolean",
          "x-checks": [
            "S1.trainability_column"
          ]
        },
        "cc_uploaders_unscreened": {
          "type": "number",
          "x-checks": [
            "S1.laundering_screen"
          ]
        },
        "auto_captions_used": {
          "type": "number",
          "x-checks": [
            "S1.no_auto_captions"
          ]
        }
      }
    },
    "probe_records": {
      "type": "number",
      "x-checks": [
        "S1.probe"
      ]
    }
  },
  "required": [
    "red_items_included",
    "sources_terms_not_reviewed",
    "sources_without_tos_basis"
  ]
}
