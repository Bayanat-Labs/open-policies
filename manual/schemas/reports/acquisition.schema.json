{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bayanatlabs.com/open/schemas/reports/acquisition.schema.json",
  "title": "Bayanat Labs gate report: job:qa/reports/acquisition.json",
  "description": "Generated by scripts/gen_report_schemas.py from the checks in manual/stages.yaml and manual/dod.yaml that read this file; do not edit by hand. Declares the type of every field a check reads. Extra keys are allowed. A check is n/a only through a memo condition, never because the report says so. Apache-2.0.",
  "type": "object",
  "x-root": "job",
  "x-path": "qa/reports/acquisition.json",
  "properties": {
    "items_with_sha256": {
      "type": "number",
      "x-checks": [
        "S2.checksums"
      ]
    },
    "items_with_retrieved_at": {
      "type": "number",
      "x-checks": [
        "S2.timestamps"
      ]
    },
    "user_agent": {
      "type": "string",
      "x-checks": [
        "S2.user_agent"
      ]
    },
    "min_seconds_between_requests_per_host": {
      "type": "number",
      "x-checks": [
        "S2.rate"
      ]
    },
    "min_seconds_between_requests_government_or_small_hosts": {
      "type": "number",
      "x-checks": [
        "S2.rate_gov"
      ]
    },
    "upstream_commit": {
      "x-checks": [
        "S2.pinned_upstream"
      ]
    },
    "max_concurrency_per_host": {
      "type": "number",
      "x-checks": [
        "S2.concurrency"
      ]
    },
    "access_denials_bypassed": {
      "type": "number",
      "x-checks": [
        "S2.denials_not_bypassed"
      ]
    },
    "proxy_or_ip_rotation_used": {
      "type": "boolean",
      "x-checks": [
        "S2.no_rotation"
      ]
    },
    "tier2_items_without_collection_basis": {
      "type": "number",
      "x-checks": [
        "S2.tier2_basis"
      ]
    }
  },
  "required": [
    "access_denials_bypassed",
    "items_with_retrieved_at",
    "items_with_sha256",
    "max_concurrency_per_host",
    "proxy_or_ip_rotation_used",
    "tier2_items_without_collection_basis"
  ]
}
