{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bayanat-Labs/open-policies/policy/schemas/licence-matrix.schema.json",
  "title": "Bayanat Labs licence matrix (licence-matrix.yaml): output tags and input allowlist/blocklist kept separate",
  "type": "object",
  "required": [
    "policy_version",
    "document",
    "status",
    "output_licence_tags",
    "code_licence",
    "output_rules",
    "input_licences"
  ],
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "document": {
      "const": "licence-matrix"
    },
    "status": {
      "type": "string"
    },
    "licence": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "output_licence_tags": {
      "type": "object",
      "required": [
        "rows"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "minItems": 7,
          "items": {
            "type": "object",
            "required": [
              "id",
              "content_type",
              "hf_licence_tag",
              "spdx_id",
              "required_record_fields",
              "rationale",
              "separate_repo",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^OUT-[0-9]{2}$"
              },
              "content_type": {
                "type": "string"
              },
              "hf_licence_tag": {
                "type": "string",
                "pattern": "^[a-z0-9._-]+$"
              },
              "alternative_hf_licence_tag": {
                "type": "string",
                "pattern": "^[a-z0-9._-]+$"
              },
              "spdx_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "alternative_spdx_id": {
                "type": "string"
              },
              "spdx_id_note": {
                "type": "string"
              },
              "tag_text": {
                "type": "string"
              },
              "required_record_fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 5
              },
              "separate_repo": {
                "type": "boolean"
              },
              "separate_config": {
                "type": "boolean"
              },
              "conditions": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "code_licence": {
      "type": "object",
      "required": [
        "hf_licence_tag",
        "spdx_id",
        "rule"
      ],
      "properties": {
        "hf_licence_tag": {
          "const": "apache-2.0"
        },
        "spdx_id": {
          "const": "Apache-2.0"
        }
      }
    },
    "output_rules": {
      "type": "object",
      "required": [
        "source_text",
        "never",
        "nc_derivatives",
        "mixed_sources_statement",
        "per_record_field",
        "bayanat_authored_data_and_docs",
        "code"
      ],
      "properties": {
        "never": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "id",
              "rule"
            ]
          }
        },
        "mixed_sources_statement": {
          "const": "Underlying content is not licensed by Bayanat Labs; see per-record fields"
        },
        "per_record_field": {
          "const": "source_license"
        },
        "bayanat_authored_data_and_docs": {
          "const": "cc-by-4.0"
        },
        "code": {
          "const": "apache-2.0"
        }
      }
    },
    "input_licences": {
      "type": "object",
      "required": [
        "allowlist",
        "blocklist",
        "rules"
      ],
      "properties": {
        "allowlist": {
          "$ref": "#/$defs/inputList"
        },
        "blocklist": {
          "$ref": "#/$defs/inputList"
        },
        "rules": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "rule"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "inputList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "spdx_ids",
          "spdx_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^IN-[AB][0-9]{2}$"
          },
          "name": {
            "type": "string"
          },
          "spdx_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "spdx_status": {
            "enum": [
              "spdx",
              "spdx_family",
              "non_spdx_status",
              "non_spdx_licence",
              "non_spdx_agreement"
            ]
          },
          "conditions": {
            "type": [
              "string",
              "null"
            ]
          },
          "exception": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
