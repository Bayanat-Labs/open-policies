{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bayanat-Labs/open-policies/policy/schemas/fidelity-checklist.schema.json",
  "title": "Fidelity checklist: the wording each policy file must keep (fidelity/checklist.yaml)",
  "description": "The wording each policy file must keep. Checked by scripts/validate_policy.py.",
  "type": "object",
  "required": [
    "document",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "document": {
      "const": "fidelity-checklist"
    },
    "policy_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "statement",
              "criterion",
              "weight",
              "anchor",
              "gate",
              "priority_code",
              "effort_code",
              "tier",
              "tier_field",
              "licence_row",
              "licence_rule",
              "allowlist",
              "blocklist",
              "principle",
              "index_only_trigger",
              "stop_rule",
              "gating_exception",
              "claims_rule",
              "exception",
              "unit_of_value"
            ]
          },
          "file": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "expect": {},
          "policy_text": {
            "type": "string"
          }
        }
      }
    }
  }
}
